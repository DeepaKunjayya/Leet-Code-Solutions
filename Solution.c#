public class Solution {
    public bool IsPalindrome(int x) {

        int y=x;
         int reverseNumber=0,counter=0;

       do {           
            

          reverseNumber=reverseNumber*10 +(y%10);

            counter++;
            y=y/10;

           // Console.WriteLine(reverseNumber);

        }while((y/10)>=0 && y>0);

        if(x<0)
          return false;
        else if(x==reverseNumber)
          return true;
        else
           return false;
        
    }
}
